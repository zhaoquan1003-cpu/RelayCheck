# ---- Branding ----
APP_NAME=RelayCheck
APP_TAGLINE=模型测智站
# Optional: pre-fill the address field; leave blank for public use.
DEFAULT_UPSTREAM_URL=

# ---- Server ----
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# Direct access: false. Behind exactly one isolated proxy: 1. Never use true.
TRUST_PROXY=false

# ---- Limits ----
TEST_TIMEOUT_MS=300000
MAX_ANSWER_BYTES=2097152
MAX_ACTIVE_JOBS=4
MAX_QUEUE=20
UPSTREAM_MAX_CONCURRENCY=8
# Per-IP creations per hour. Self-hosted single-user instances may raise this.
CREATE_PER_IP_PER_HOUR=30
ACTIVE_PER_IP=2
LIST_PER_MINUTE=120
SSE_MAX_PER_IP=3
SSE_MAX_CONNECTIONS=200
# Hides only the list. Detail/share URLs remain accessible by ID.
PUBLIC_LIST_ENABLED=true

# ---- Retention ----
RETENTION_DAYS=30
MAX_RECORDS=500

# ---- Security ----
# Never enable this in production. Only tests use private upstreams.
ALLOW_PRIVATE_UPSTREAMS=false
# Optional comma-separated exact hosts or *.suffix entries.
UPSTREAM_ALLOWLIST=
# Generate with: openssl rand -hex 32
# Store only SHA-256: printf '%s' "$TOKEN" | sha256sum
ADMIN_TOKEN_HASH=

# ---- Fingerprint tiers (optional) ----
MODEL_TIERS_FILE=./config/model-tiers.json

# ---- Deployment ----
SITE_ADDRESS=localhost
# Build-time public path. For an existing site's subdirectory use /zhishang/.
# The reverse proxy must strip this prefix before forwarding to the app.
VITE_BASE_PATH=/
