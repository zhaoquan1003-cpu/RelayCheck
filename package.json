{
  "name": "relay-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"node --watch --import tsx src/server/index.ts\" \"vite --port 5173\"",
    "dev:server": "node --watch --import tsx src/server/index.ts",
    "dev:web": "vite --port 5173",
    "build:web": "vite build",
    "build:server": "tsup",
    "build": "vite build && tsup",
    "start": "node --import ./scripts/production-env.mjs dist/server/index.js",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "vite build && tsup && playwright test",
    "smoke:prod": "node scripts/smoke-production.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:restore": "node scripts/restore-db.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm e2e && pnpm smoke:prod",
    "question:render": "tsx scripts/render-question.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.11",
    "dompurify": "^3.2.6",
    "eventsource-parser": "^3.0.1",
    "fastify": "^5.4.0",
    "ipaddr.js": "^2.2.0",
    "katex": "^0.19.1",
    "markdown-it": "^14.1.0",
    "parse5": "^8.1.1",
    "undici": "^7.11.0",
    "vue": "^3.5.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.10",
    "@vitejs/plugin-vue": "^6.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.1"
  }
}
